{
  "name": "keepfacts",
  "version": "0.3.3",
  "description": "A local-first exact-fact preservation checker for AI-rewritten text.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.check.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "eval": "node --experimental-strip-types scripts/evaluate.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "render:share-card": "node scripts/render-share-card.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "npm run verify:release && npm run test && npm run eval && npm run build",
    "check:all": "npm run check && npm run test:e2e:ci"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
